e = System.IO.Path.Combine(dir, name &amp; &quot;_&quot; &amp; i &amp; ext)&#xA;        While System.IO.File.Exists(candidate)&#xA;            i += 1&#xA;            candidate = System.IO.Path.Combine(dir, name &amp; &quot;_&quot; &amp; i &amp; ext)&#xA;        End While&#xA;        Return candidate&#xA;    End Function&#xA;&#xA;' --- Replace ZipArchiveEntry.ExtractToFile (NOT available in your UiPath) ---&#xA;Dim ExtractEntryToFile As System.Action(Of System.IO.Compression.ZipArchiveEntry, String) =&#xA;    Sub(entry As System.IO.Compression.ZipArchiveEntry, mergeDir As String)&#xA;        Dim targetPath = System.IO.Path.Combine(mergeDir, entry.FullName)&#xA;        Dim dir = System.IO.Path.GetDirectoryName(targetPath)&#xA;        If Not String.IsNullOrEmpty(dir) Then System.IO.Directory.CreateDirectory(dir)&#xA;&#xA;        ' Skip directory entries&#xA;        If String.IsNullOrWhiteSpace(entry.Name) Then Return&#xA;&#xA;        targetPath = MakeUniquePath(targetPath)&#xA;&#xA;        Using inStream = entry.Open()&#xA;            Using outStream As New System.IO.FileStream(targetPath, System.IO.FileMode.Create, System.IO.FileAccess.Write, System.IO.FileShare.None)&#xA;                inStream.CopyTo(outStream)&#xA;            End Using&#xA;        End Using&#xA;    End Sub&#xA;&#xA;' --- Extract nested zips WITHOUT ZipFile.ExtractToDirectory ---&#xA;Dim ExtractZipToFolder As System.Action(Of String, String) =&#xA;    Sub(zipPath As String, destFolder As String)&#xA;        System.IO.Directory.CreateDirectory(destFolder)&#xA;        Using fs As New System.IO.FileStream(zipPath, System.IO.FileMode.Open, System.IO.FileAccess.Read, System.IO.FileShare.Read)&#xA;            Using zip As New System.IO.Compression.ZipArchive(fs, System.IO.Compression.ZipArchiveMode.Read)&#xA;                For Each e In zip.Entries&#xA;                    ExtractEntryToFile(e, destFolder)&#xA;                Next&#xA;            End Using&#xA;        End Using&#xA;    End Sub&#xA;&#xA;Dim ExtractNestedZipsAndFilter As System.Action(Of String) =&#xA;    Sub(folder As String)&#xA;        ' Extract any zip files found inside folder&#xA;        Dim zips = System.IO.Directory.GetFiles(folder, &quot;*.zip&quot;, System.IO.SearchOption.AllDirectories)&#xA;        For Each z In zips&#xA;            Dim extractDir = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(z), System.IO.Path.GetFileNameWithoutExtension(z))&#xA;            ExtractZipToFolder(z, extractDir)&#xA;            System.IO.File.Delete(z)&#xA;        Next&#xA;&#xA;        ' Remove images&#xA;        For Each f In System.IO.Directory.GetFiles(folder, &quot;*.*&quot;, System.IO.SearchOption.AllDirectories)&#xA;            Dim ext = System.IO.Path.GetExtension(f).ToLowerInvariant()&#xA;            If ext = &quot;.jpg&quot; OrElse ext = &quot;.jpeg&quot; OrElse ext = &quot;.png&quot; OrElse ext = &quot;.gif&quot; OrElse ext = &quot;.bmp&quot; Then&#xA;                System.IO.File.Delete(f)&#xA;            End If&#xA;        Next&#xA;    End Sub&#xA;&#xA;'FAST: stream one url to file&#xA;Dim DownloadOneToFileAsync As System.Func(Of System.Net.Http.HttpClient, String, String, System.Threading.Tasks.Task) =&#xA;    Async Function(http As System.Net.Http.HttpClient, url As String, targetPath As String) As System.Threading.Tasks.Task&#xA;        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(targetPath))&#xA;&#xA;        Using resp = Await http.GetAsync(url, System.Net.Http.HttpCompletionOption.ResponseHeadersRead).ConfigureAwait(False)&#xA;            resp.EnsureSuccessStatusCode()&#xA;            Using netStream = Await resp.Content.ReadAsStreamAsync().ConfigureAwait(False)&#xA;                Dim safePath = MakeUniquePath(targetPath)&#xA;                Using fs As New System.IO.FileStream(safePath, System.IO.FileMode.Create, System.IO.FileAccess.Write, System.IO.FileShare.None, 1024 * 1024, True)&#xA;                    Await netStream.CopyToAsync(fs, 1024 * 1024).ConfigureAwait(False)&#xA;                End Using&#xA;            End Using&#xA;        End Using&#xA;    End Function&#xA;&#xA;Dim DownloadManyAsync As System.Func(Of System.Net.Http.HttpClient,&#xA;                                   System.Collections.Generic.List(Of System.Collections.Generic.KeyValuePair(Of String, String)),&#xA;                                   String,&#xA;                                   Integer,&#xA;                                   System.Threading.Tasks.Task) =&#xA;    Async Function(http As System.Net.Http.HttpClient,&#xA;                   items As System.Collections.Generic.List(Of System.Collections.Generic.KeyValuePair(Of String, String)),&#xA;                   folder As String,&#xA;                   parallel As Integer) As System.Threading.Tasks.Task&#xA;&#xA;        If items Is Nothing OrElse items.Count = 0 Then Return&#xA;&#xA;        Dim throttler As New System.Threading.SemaphoreSlim(parallel)&#xA;        Dim tasks As New System.Collections.Generic.List(Of System.Threading.Tasks.Task)()&#xA;&#xA;        For Each it In items&#xA;            Dim url = it.Key&#xA;            Dim name = it.Value&#xA;            tasks.Add(System.Threading.Tasks.Task.Run(&#xA;                Async Function()&#xA;                    Await throttler.WaitAsync().ConfigureAwait(False)&#xA;                    Try&#xA;                        Dim filePath = System.IO.Path.Combine(folder, name)&#xA;                        Await DownloadOneToFileAsync(http, url, filePath).ConfigureAwait(False)&#xA;                    Finally&#xA;                        throttler.Release()&#xA;                    End Try&#xA;                End Function))&#xA;        Next&#xA;&#xA;        Await System.Threading.Tasks.Task.WhenAll(tasks).ConfigureAwait(False)&#xA;    End Function&#xA;&#xA;Dim PollOperationAsync As System.Func(Of System.Net.Http.HttpClient, String, String, Integer, Integer, System.Threading.Tasks.Task(Of Newtonsoft.Json.Linq.JObject)) =&#xA;    Async Function